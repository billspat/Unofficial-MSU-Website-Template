{
  "name": "msu-css-template",
  "version": "1.0.0",
  "description": "Accessible, mobile-responsive HTML/CSS template suite for Michigan State University lab, faculty, and project websites using Tailwind CSS & DaisyUI",
  "scripts": {
    "build:css": "tailwindcss -i ./src/css/input.css -o ./dist/css/msu-theme.css --minify",
    "watch:css": "tailwindcss -i ./src/css/input.css -o ./dist/css/msu-theme.css --watch",
    "dev": "npm run watch:css",
    "build": "npm run build:css",
    "serve": "npx serve ."
  },
  "keywords": [
    "msu",
    "michigan-state-university",
    "daisyui",
    "tailwindcss",
    "accessibility",
    "wcag",
    "ssg-template",
    "astro",
    "nextjs",
    "svelte"
  ],
  "author": "MSU Template Team",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "daisyui": "^4.12.23",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
